    Decision engine binding
  </message>
<message name="IDS_XR_SHIELD_ENGINE_VENDORED" desc="Row label: the vendored engine pin (version of record)" xr-id="shield.engine.vendored">
    Vendored engine pin
  </message>
<message name="IDS_XR_SHIELD_ENGINE_RUST_BOUND" desc="Row label: whether the Rust engine is actually bound (honesty row)" xr-id="shield.engine.rust.bound">
    Rust engine bound
  </message>
<message name="IDS_XR_SHIELD_BUNDLES_HEADING" desc="Section heading: bundle slot rows" xr-id="shield.bundles.heading">
    List bundles
  </message>
<message name="IDS_XR_SHIELD_BUNDLE_ACTIVE" desc="Row label: the active bundle slot" xr-id="shield.bundle.active">
    Active bundle
  </message>
<message name="IDS_XR_SHIELD_BUNDLE_LKG" desc="Row label: the last-known-good slot" xr-id="shield.bundle.lkg">
    Last known good
  </message>
<message name="IDS_XR_SHIELD_BUNDLE_PINS" desc="Row label: the pinned slots (last two)" xr-id="shield.bundle.pins">
    Pinned slots (last two)
  </message>
<message name="IDS_XR_SHIELD_SLOT_VALUE" desc="One bundle slot rendered: name, version, digest" xr-id="shield.slot.value">
