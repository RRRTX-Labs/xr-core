  </message>
<message name="IDS_XR_SHIELD_STATE_NORMAL" desc="Page state: normal posture (blocking active, green chip)" xr-id="shield.state.normal">
    Shield state: normal — blocking active
  </message>
<message name="IDS_XR_SHIELD_STATE_ENGINE_DEAD" desc="Page state: engine death (fail-open, amber chip — distinct from blocked-nothing)" xr-id="shield.state.engine.dead">
    Shield state: engine dead — fail-open, requests pass unblocked
  </message>
<message name="IDS_XR_SHIELD_STATE_ENGINE_POISONED" desc="Page state: engine poison (fail-open, amber chip)" xr-id="shield.state.engine.poisoned">
