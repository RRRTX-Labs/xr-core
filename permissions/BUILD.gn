# Intent: S0 — the permissions subsystem's build graph (P15-CLOSE C2): the
# std-only, clock-free C++20 core (ADR-0051 DRAFT) as a source_set for the
# browser build, plus the clock-owning host as an executable, mirroring the
# identity/ and policy/ BUILD.gn shape. The lane that actually BUILDS AND TESTS
# this core in CI is the depth-general suite discovery (every
# xr-core/*/tests/Makefile); this file is the gn-side wiring for the browser
# target, exercised where gn/ninja exist (NOT-RUN here — method:
# docs/qa/browser-harness.md, the rig lane).
#
# Label and shape follow policy/, commands/, shield/ and update/: the shared
# primitives are //xr/common:common_core (ADR-0043), headers are listed in
# sources, and there is no import because nothing here runs a python action.

source_set("permissions_core") {
  sources = [
    "core/audit.cc",
    "core/audit.h",
    "core/envelope.cc",
    "core/envelope.h",
    "core/json.h",
    "core/merge.cc",
    "core/merge.h",
    "core/ops.cc",
    "core/ops.h",
    "core/present.cc",
    "core/present.h",
    "core/store.cc",
    "core/store.h",
    "core/types.cc",
    "core/types.h",
  ]

  public_deps = [ "//xr/common:common_core" ]
  # NOTE: no Chromium deps; std-only and clock-free by design (ADR-0051).
}

# The clock-owning sweep: the only target under permissions/ that reads a clock.
executable("permissions_host") {
  sources = [ "host/permissions_host.cc" ]
  deps = [ ":permissions_core" ]
}
