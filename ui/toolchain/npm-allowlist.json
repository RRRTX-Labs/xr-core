{
  "schema_version": 1,
  "comment": "The audited npm package allowlist for ui/toolchain (replaces the stale 'exactly three packages' prose in package.json). Every package in package-lock.json must match an entry here (exact name or glob); tools/npm_allowlist_check.py enforces it. Adding a package is a DEPENDENCY RULES ceremony: docs/dependencies/ entry + exact pin + license + `npm ci --ignore-scripts`.",
  "packages": [
    {"name": "lit", "match": "exact", "version": "3.3.3", "license": "BSD-3-Clause",
     "role": "WebUI component framework (runtime, bundled)",
     "docs": "docs/dependencies/lit.yaml"},
    {"name": "@lit/*", "match": "glob", "version": "3.x",
     "license": "BSD-3-Clause",
     "role": "lit's scoped transitive package (@lit/reactive-element)",
     "docs": "docs/dependencies/lit.yaml"},
    {"name": "lit-*", "match": "glob", "version": "3.x",
     "license": "BSD-3-Clause",
     "role": "lit's unscoped transitive packages (lit-element, lit-html)",
     "docs": "docs/dependencies/lit.yaml"},
    {"name": "@lit-labs/*", "match": "glob", "version": "1.x",
     "license": "BSD-3-Clause",
     "role": "lit's ssr-dom-shim transitive package",
     "docs": "docs/dependencies/lit.yaml"},
    {"name": "esbuild", "match": "exact", "version": "0.28.2", "license": "MIT",
     "role": "WebUI bundler (build-time only)",
     "docs": "docs/dependencies/esbuild.yaml"},
    {"name": "@esbuild/*", "match": "glob", "version": "0.28.2",
     "license": "MIT",
     "role": "esbuild platform binaries (optionalDependencies, integrity-pinned)",
     "docs": "docs/dependencies/esbuild.yaml"},
    {"name": "typescript", "match": "exact", "version": "5.9.3", "license": "Apache-2.0",
     "role": "strict type-check of the views (build-time only)",
     "docs": "docs/dependencies/typescript.yaml"},
    {"name": "@types/trusted-types", "match": "exact", "version": "2.x",
     "license": "MIT",
     "role": "TypeScript ambient types (build-time only)",
     "docs": "docs/dependencies/typescript.yaml"},
    {"name": "axe-core", "match": "exact", "version": "4.13.0", "license": "MPL-2.0",
     "role": "a11y rules engine (§11.6; dev-time, farm-executed — P9-T7)",
     "docs": "docs/dependencies/axe-core.yaml"}
  ]
}
