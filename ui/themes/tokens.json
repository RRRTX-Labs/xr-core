      "danger-caution": "#9a6700",
      "danger-caution-bg": "#fff8c5",
      "danger-destructive": "#cf222e",
      "danger-destructive-bg": "#ffebe9",
      "critical-red": "#d1242f",
      "critical-red-bg": "#ffe9e9",
      "success-ok": "#1a7f37",
      "success-ok-bg": "#dafbe1",
      "trust-standard": "#2e7d32",
      "trust-shield": "#1565c0",
      "trust-fortress": "#6a1b9a",
