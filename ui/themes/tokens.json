{
  "schema": "xr-design-tokens",
  "schema_version": 1,
  "note": "P8-T2 single token source (Plan §10 + theme-tokens-v1 contract). One source, two generated consumers: ui/themes/tokens.h (C++ uint32_t 0xAARRGGBB accessors — NO Skia include) and ui/tokens.css (--xr-* custom properties). Both are GENERATED (tools/tokens_gen.py, --check diff-clean); never hand-edit the outputs. 'critical-red' is RESERVED in data + validator: it is never themeable to a non-alarming color (a theme doc mapping critical-red to anything outside the canonical alarming family is refused). Per-theme values: the 'themes' map carries a FULL value set per built-in theme; v1 ships 'light' (the P7 browser-chrome baseline, values preserved); T3 adds Dark/HighContrast/System(+2 curated) into this same data. Fonts: family tokens reference SYSTEM font stacks only — the bundled-font list is EMPTY in v0 (locked decision: fonts are P30 territory).",
  "reserved": {
    "critical-red": "reserved token: never themeable to a non-alarming color; the loader/validator refuses any theme whose critical-red deviates from the canonical alarming family without an in-data waiver"
  },
  "tokens": {
    "surface": { "type": "color", "usage": "page background", "pairing": [], "security_critical": false },
    "surface-raised": { "type": "color", "usage": "cards, dialogs, chips", "pairing": [], "security_critical": false },
    "surface-muted": { "type": "color", "usage": "secondary fills, table stripes", "pairing": [], "security_critical": false },
    "surface-sunken": { "type": "color", "usage": "inset wells, code blocks base", "pairing": [], "security_critical": false },
    "text": { "type": "color", "usage": "primary text on surfaces", "pairing": ["surface", "surface-raised", "surface-muted"], "security_critical": false },
    "text-dim": { "type": "color", "usage": "secondary/disabled text", "pairing": ["surface", "surface-raised"], "security_critical": false },
    "text-inverse": { "type": "color", "usage": "text on accents and trust colors", "pairing": ["accent", "accent-hover", "trust-standard", "trust-shield", "trust-fortress"], "security_critical": false },
    "border": { "type": "color", "usage": "default hairlines", "pairing": [], "security_critical": false },
    "border-strong": { "type": "color", "usage": "emphasized borders", "pairing": [], "security_critical": false },
    "accent": { "type": "color", "usage": "primary interactive accent", "pairing": ["surface", "surface-raised"], "security_critical": false },
    "accent-hover": { "type": "color", "usage": "accent hover state", "pairing": ["surface", "surface-raised"], "security_critical": false },
    "accent-soft": { "type": "color", "usage": "accent tint fills (hints)", "pairing": [], "security_critical": false },
    "danger-caution": { "type": "color", "usage": "caution (warning) text/border — §10 danger classes", "pairing": ["surface", "surface-raised"], "security_critical": true },
    "danger-caution-bg": { "type": "color", "usage": "caution tint fill", "pairing": [], "security_critical": false },
    "danger-destructive": { "type": "color", "usage": "destructive text/border — §10 danger classes", "pairing": ["surface", "surface-raised", "danger-destructive-bg"], "security_critical": true },
    "danger-destructive-bg": { "type": "color", "usage": "destructive tint fill", "pairing": [], "security_critical": false },
    "critical-red": { "type": "color", "usage": "system-critical alarms — RESERVED (see top note)", "pairing": ["surface", "surface-raised", "critical-red-bg"], "security_critical": true, "reserved": true },
    "critical-red-bg": { "type": "color", "usage": "critical tint fill", "pairing": [], "security_critical": false },
    "success-ok": { "type": "color", "usage": "positive confirmation", "pairing": ["surface", "surface-raised"], "security_critical": false },
    "success-ok-bg": { "type": "color", "usage": "positive tint fill", "pairing": [], "security_critical": false },
    "trust-standard": { "type": "color", "usage": "identity trust tier Standard (Identity color-bar)", "pairing": ["surface", "surface-raised", "trust-standard-bg"], "security_critical": true },
    "trust-shield": { "type": "color", "usage": "identity trust tier Shield (Identity color-bar)", "pairing": ["surface", "surface-raised", "trust-shield-bg"], "security_critical": true },
    "trust-fortress": { "type": "color", "usage": "identity trust tier Fortress (Identity color-bar)", "pairing": ["surface", "surface-raised", "trust-fortress-bg"], "security_critical": true },
    "trust-standard-bg": { "type": "color", "usage": "Standard tier tint fill", "pairing": [], "security_critical": false },
    "trust-shield-bg": { "type": "color", "usage": "Shield tier tint fill", "pairing": [], "security_critical": false },
    "trust-fortress-bg": { "type": "color", "usage": "Fortress tier tint fill", "pairing": [], "security_critical": false },
    "code-bg": { "type": "color", "usage": "inline code background", "pairing": [], "security_critical": false },
    "focus-ring": { "type": "color", "usage": "keyboard focus ring (a11y: visible focus)", "pairing": [], "security_critical": false },
    "overlay-scrim": { "type": "color", "usage": "modal scrim (alpha)", "pairing": [], "security_critical": false },
    "space-1": { "type": "dimension", "usage": "4px spacing unit", "pairing": [], "security_critical": false },
    "space-2": { "type": "dimension", "usage": "8px spacing unit", "pairing": [], "security_critical": false },
    "space-3": { "type": "dimension", "usage": "12px spacing unit", "pairing": [], "security_critical": false },
    "space-4": { "type": "dimension", "usage": "16px spacing unit", "pairing": [], "security_critical": false },
    "radius": { "type": "dimension", "usage": "default corner radius (px)", "pairing": [], "security_critical": false },
    "radius-lg": { "type": "dimension", "usage": "large corner radius (px)", "pairing": [], "security_critical": false },
    "font-size-sm": { "type": "dimension", "usage": "small text size (px)", "pairing": [], "security_critical": false },
    "font-size-base": { "type": "dimension", "usage": "base text size (px)", "pairing": [], "security_critical": false },
    "font-size-lg": { "type": "dimension", "usage": "large text size (px)", "pairing": [], "security_critical": false },
    "font-family-ui": { "type": "font", "usage": "UI font stack (system fonts only — no bundled fonts in v0)", "pairing": [], "security_critical": false },
    "font-family-mono": { "type": "font", "usage": "monospace stack for code/ids (system fonts only)", "pairing": [], "security_critical": false }
  },
  "themes": {
